#!/usr/bin/env elixir

# Zorb Showcase Script
# Run a Z-machine story with style.

case System.argv() do
  [] ->
    IO.puts("Usage: bin/run_story path/to/story.z[1-8] [--cache] [--trace]")
    System.halt(1)

  _ ->
    :ok
end

# Ensure the app is loaded so dependencies (Wasmex, Orb) are available
Mix.install([
  {:zorb, path: ".", env: :dev}
], quiet: true)

Zorb.CLI.main(System.argv())
